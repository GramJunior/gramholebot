{
  "name": "emberveil-server",
  "version": "0.1.0",
  "private": true,
  "description": "Онлайн-бэкенд ЭМБЕРВЕЙЛ: Cloudflare Workers + D1",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --no-warnings --test test/*.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 migrations apply emberveil --local",
    "db:init": "wrangler d1 migrations apply emberveil --remote",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry"
  },
  "engines": { "node": ">=22.5" },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
